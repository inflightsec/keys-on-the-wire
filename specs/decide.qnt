// ADR-0054 — Quint model of the pure policy core (src/kow/policy.py decide())
// plus the execution-layer fail-closed step and the snapshot-publish race.
//
// Scope (deliberately narrow, see ADR-0054 "Out of scope"): exact-host
// bindings, method/path-prefix scopes, header-placeholder matching. No
// wildcard/subdomain discriminators, no body path, no computed signers —
// those share the verdict shape and add no new interleavings.
//
// Checked two ways:
//   1. `quint test specs/generated/conformance.qnt` — every ADR-0013 policy
//      fixture replayed against decideV/executeV (generated by
//      tests/test_spec_conformance.py; drift between fixtures and model
//      fails CI).
//   2. `quint run --main=decideSpec --invariant=allGates specs/decide.qnt`
//      — random exploration of the request/config space against the
//      G3/G4/G5 gate invariants.

module decide_model {
  // ── Types ────────────────────────────────────────────────────────────
  // connectHost: "" means "no CONNECT tunnel" (plain HTTP / same host).
  // methods == Set() means "all verbs" (the ADR-0047 unscoped smell).
  // pathPrefixes == Set() means "all paths".
  type Binding = { host: str, methods: Set[str], pathPrefixes: Set[str] }
  type Secret = { name: str, placeholder: str, bindings: List[Binding] }
  type Cfg = { secrets: List[Secret], unmatchedDeny: bool }
  type Request = {
    host: str,
    connectHost: str,
    method: str,
    path: str,
    // Placeholders literally present in the request's target headers.
    placeholders: Set[str]
  }

  // The audited triple + synthesised status. status == 0 means "no
  // response synthesised" (None in Python): the G5 forward-verbatim shape.
  type Verdict = { decision: str, reason: str, secretName: str, status: int }

  // ── Pure helpers (mirror policy.py) ──────────────────────────────────
  pure def bindingMatchesHost(b: Binding, host: str): bool = b.host == host

  pure def bindingMatchesScope(b: Binding, method: str, path: str): bool =
    (b.methods == Set() or b.methods.contains(method)) and
    (b.pathPrefixes == Set() or b.pathPrefixes.exists(p => startsWith(path, p)))

  // Quint has no string prefix operator, so path scopes are modeled as
  // EXACT segments — weaker than production's prefix matching. The
  // conformance generator refuses (hard error) any fixture that binds
  // `paths:` until this abstraction is upgraded, so the divergence can
  // never hide inside a green run. Random exploration DOES exercise the
  // exact-segment scope branch via the CFG below.
  pure def startsWith(s: str, prefix: str): bool = s == prefix

  pure def hostBoundAnywhere(cfg: Cfg, host: str): bool =
    cfg.secrets.indices().exists(i => cfg.secrets[i].bindings.indices().exists(j => bindingMatchesHost(cfg.secrets[i].bindings[j], host)))

  // First binding of `s` whose host gate matches, as a singleton-or-empty
  // list (Quint's stand-in for Option).
  pure def matchedBinding(s: Secret, host: str): List[Binding] =
    s.bindings.select(b => bindingMatchesHost(b, host))

  pure def placeholderMatches(cfg: Cfg, req: Request): List[Secret] =
    cfg.secrets.select(s => req.placeholders.contains(s.placeholder))

  // ── decide() — the six steps, in order (policy.py:205) ───────────────
  pure def decideV(cfg: Cfg, req: Request): Verdict = {
    // 1. SNI/Host consistency (G3)
    if (req.connectHost != "" and req.connectHost != req.host)
      { decision: "denied", reason: "sni_host_mismatch", secretName: "", status: 403 }
    // 2. Destination allow-list
    else if (cfg.unmatchedDeny and not(hostBoundAnywhere(cfg, req.host)))
      { decision: "denied", reason: "unmatched_destination", secretName: "", status: 403 }
    else {
      val matches = placeholderMatches(cfg, req)
      // 3. No placeholder → forward untouched (no audit event either).
      if (matches.length() == 0)
        { decision: "forward_unmodified", reason: "", secretName: "", status: 0 }
      // 3b. Two configured placeholders in one request → refuse to guess.
      else if (matches.length() > 1)
        { decision: "denied", reason: "ambiguous_placeholder_match", secretName: "", status: 400 }
      else {
        val chosen = matches[0]
        val mb = matchedBinding(chosen, req.host)
        // 4. Matched secret not bound to this destination (G5: verbatim).
        if (mb.length() == 0)
          { decision: "denied", reason: "destination_not_in_binding",
            secretName: chosen.name, status: 0 }
        // 5. Binding scope must permit the verb+path (G5: verbatim).
        else if (not(bindingMatchesScope(mb[0], req.method, req.path)))
          { decision: "denied", reason: "binding_scope_violation",
            secretName: chosen.name, status: 0 }
        // 6. Allowed — execution layer takes over.
        else
          { decision: "allowed", reason: "binding_matched",
            secretName: chosen.name, status: 0 }
      }
    }
  }

  // ── Execution layer (addon.py): fetch can fail AFTER an allowed verdict.
  // G4: fail closed — 503, never a guessed credential. `injected` is the
  // fixture's observable: did real secret bytes replace the placeholder?
  type Outcome = { decision: str, reason: str, secretName: str, status: int, injected: bool }

  pure def executeV(cfg: Cfg, req: Request, backendUp: bool): Outcome = {
    val v = decideV(cfg, req)
    if (v.decision == "allowed" and backendUp)
      { decision: "allowed", reason: v.reason, secretName: v.secretName,
        status: 0, injected: true }
    else if (v.decision == "allowed")  // backend down mid-request (G4)
      { decision: "denied", reason: "secret_unavailable", secretName: v.secretName,
        status: 503, injected: false }
    else
      { decision: v.decision, reason: v.reason, secretName: v.secretName,
        status: v.status, injected: false }
  }
}

// ── Random-exploration harness: arbitrary requests against a config
// universe, gate invariants checked on every outcome. ────────────────────
module decideSpec {
  import decide_model.*

  // Small closed universes — enough to reach every branch of decideV.
  pure val HOSTS = Set("api.anthropic.com", "api.github.com", "evil.example", "169.254.169.254")
  pure val METHODS = Set("GET", "POST", "DELETE")
  pure val PATHS = Set("/v1/messages", "/gists", "/")
  pure val PLACEHOLDERS = Set("PH_ANTHROPIC", "PH_GITHUB")

  pure val CFG: Cfg = {
    secrets: [
      { name: "ANTHROPIC_API_KEY", placeholder: "PH_ANTHROPIC",
        bindings: [ { host: "api.anthropic.com", methods: Set(), pathPrefixes: Set() } ] },
      { name: "GITHUB_PAT", placeholder: "PH_GITHUB",
        bindings: [ { host: "api.github.com", methods: Set("GET"),
                      pathPrefixes: Set("/gists") } ] }
    ],
    unmatchedDeny: false
  }

  var lastReq: Request
  var lastOutcome: Outcome
  var lastCfg: Cfg

  action init = all {
    lastReq' = { host: "api.anthropic.com", connectHost: "", method: "GET",
                 path: "/", placeholders: Set() },
    lastCfg' = CFG,
    lastOutcome' = executeV(CFG, { host: "api.anthropic.com", connectHost: "",
                                   method: "GET", path: "/", placeholders: Set() }, true),
  }

  action step = {
    nondet host = oneOf(HOSTS)
    nondet connect = oneOf(HOSTS.union(Set("")))
    nondet method = oneOf(METHODS)
    nondet path = oneOf(PATHS)
    nondet phs = oneOf(powerset(PLACEHOLDERS))
    nondet deny = oneOf(Set(true, false))
    nondet up = oneOf(Set(true, false))
    val cfg = { secrets: CFG.secrets, unmatchedDeny: deny }
    val req = { host: host, connectHost: connect, method: method, path: path, placeholders: phs }
    all {
      lastReq' = req,
      lastCfg' = cfg,
      lastOutcome' = executeV(cfg, req, up),
    }
  }

  // ── Invariants (each recomputes the property independently of decideV's
  // own control flow — the redundancy is the check) ──────────────────────

  // G5: the two enforcement-by-omission denials never synthesise a response.
  val g5Omission =
    (lastOutcome.reason == "destination_not_in_binding" or
     lastOutcome.reason == "binding_scope_violation")
      implies (lastOutcome.status == 0 and not(lastOutcome.injected))

  // Hard pre-gates always synthesise 4xx and never inject.
  val hardGates =
    (lastOutcome.reason == "sni_host_mismatch" or
     lastOutcome.reason == "unmatched_destination" or
     lastOutcome.reason == "ambiguous_placeholder_match")
      implies (lastOutcome.status >= 400 and lastOutcome.status < 500
               and not(lastOutcome.injected))

  // G3+G4+scope conjunction: injection happened ⇒ tunnel is consistent AND
  // exactly one placeholder matched AND that secret has a binding for this
  // host whose scope admits this verb+path.
  val injectionSound =
    lastOutcome.injected implies (
      (lastReq.connectHost == "" or lastReq.connectHost == lastReq.host) and
      placeholderMatches(lastCfg, lastReq).length() == 1 and
      lastCfg.secrets.indices().exists(i => val s = lastCfg.secrets[i]
        s.name == lastOutcome.secretName and
        lastReq.placeholders.contains(s.placeholder) and
        matchedBinding(s, lastReq.host).length() == 1 and
        bindingMatchesScope(matchedBinding(s, lastReq.host)[0], lastReq.method, lastReq.path))
    )

  // G4: a placeholder that matched but could not be positively resolved
  // never leaves as anything but placeholder-verbatim or an explicit deny.
  val failClosed =
    (lastOutcome.decision != "allowed") implies not(lastOutcome.injected)

  // ── Note locality (ADR-0055): a secret's note-carried config is a first-
  // class citizen but its blast radius is EXACTLY that secret. Stated as
  // non-interference: removing secret S from the config may only change the
  // verdict for requests that carry S's placeholder or target a host S
  // binds (the destination allow-list is legitimately a union). Any other
  // influence would mean one secret's notes reconfigured its neighbours. ──
  pure def dropSecret(cfg: Cfg, name: str): Cfg =
    { secrets: cfg.secrets.select(x => x.name != name), unmatchedDeny: cfg.unmatchedDeny }

  val noteLocality =
    lastCfg.secrets.indices().forall(i => {
      val s = lastCfg.secrets[i]
      val touchesRequest =
        lastReq.placeholders.contains(s.placeholder) or
        s.bindings.indices().exists(j => bindingMatchesHost(s.bindings[j], lastReq.host))
      touchesRequest or
        (decideV(lastCfg, lastReq) == decideV(dropSecret(lastCfg, s.name), lastReq))
    })

  val allGates = g5Omission and hardGates and injectionSound and failClosed
                 and noteLocality
}

// ── Snapshot-publish race (addon.py:349-350 / 433-435) ──────────────────
// The ADR-0032 notes refresh runs on a worker thread (asyncio.to_thread)
// and publishes `_header_index` and `_header_index_config` as TWO separate
// field writes. A handler on the event-loop thread reads them in
// `_index_for` without a lock. This module models both the current
// two-write publish (ATOMIC_PUBLISH == false) and the fixed single-swap
// design (true).
//
//   quint run --main=snapshotRace --invariant=servedCoherent specs/decide.qnt
//
// finds the torn interleaving for the current design;
// `tornPublishWitnessTest` (quint test) pins the exact trace
// deterministically so the finding survives as a regression witness.
module snapshotRace {
  // Generations stand in for (config, header_index) object identity.
  var vIdxGen: int        // self._header_index      (write 1 of publish)
  var vCfgGen: int        // self._header_index_config (write 2 of publish)
  var publishing: int     // generation mid-publish, -1 when quiescent
  var handlerCfg: int     // handler's captured config gen (-1: no request)
  var handlerIdx: int     // index gen the handler resolved (-1: pending)
  var servedMixed: bool   // a decide() ran with cfgGen != idxGen

  const ATOMIC_PUBLISH: bool  // see snapshotCurrent / snapshotFixed below

  action init = all {
    vIdxGen' = 0, vCfgGen' = 0, publishing' = -1,
    handlerCfg' = -1, handlerIdx' = -1, servedMixed' = false,
  }

  // Refresh thread, atomic variant: both fields move together.
  action publishAtomic = all {
    ATOMIC_PUBLISH,
    publishing == -1,
    vIdxGen' = vIdxGen + 1, vCfgGen' = vCfgGen + 1,
    publishing' = -1, handlerCfg' = handlerCfg, handlerIdx' = handlerIdx,
    servedMixed' = servedMixed,
  }

  // Refresh thread, current code: write 1 (index), interleaving point,
  // then write 2 (config).
  action publishWrite1 = all {
    not(ATOMIC_PUBLISH), publishing == -1,
    publishing' = vCfgGen + 1,
    vIdxGen' = vIdxGen + 1,
    vCfgGen' = vCfgGen, handlerCfg' = handlerCfg, handlerIdx' = handlerIdx,
    servedMixed' = servedMixed,
  }
  action publishWrite2 = all {
    not(ATOMIC_PUBLISH), publishing != -1,
    vCfgGen' = publishing, publishing' = -1,
    vIdxGen' = vIdxGen, handlerCfg' = handlerCfg, handlerIdx' = handlerIdx,
    servedMixed' = servedMixed,
  }

  // Handler: capture config (handler entry), later resolve the index via
  // _index_for's identity check against the *live* fields.
  action handlerCapture = all {
    handlerCfg == -1,
    handlerCfg' = vCfgGen, handlerIdx' = -1,
    vIdxGen' = vIdxGen, vCfgGen' = vCfgGen, publishing' = publishing,
    servedMixed' = servedMixed,
  }
  action handlerResolve = all {
    handlerCfg != -1, handlerIdx == -1,
    // _index_for: if the live config field still equals the captured one,
    // return the live index field (torn if write 1 landed, write 2 didn't);
    // else rebuild coherently for the captured config.
    handlerIdx' = if (vCfgGen == handlerCfg) vIdxGen else handlerCfg,
    handlerCfg' = handlerCfg,
    vIdxGen' = vIdxGen, vCfgGen' = vCfgGen, publishing' = publishing,
    servedMixed' = servedMixed,
  }
  action handlerServe = all {
    handlerCfg != -1, handlerIdx != -1,
    servedMixed' = (servedMixed or (handlerIdx != handlerCfg)),
    handlerCfg' = -1, handlerIdx' = -1,
    vIdxGen' = vIdxGen, vCfgGen' = vCfgGen, publishing' = publishing,
  }

  action step = any {
    publishAtomic, publishWrite1, publishWrite2,
    handlerCapture, handlerResolve, handlerServe,
  }

  // The coherence invariant decide() implicitly assumes: config and index
  // generations agree for every served request.
  val servedCoherent = not(servedMixed)

  // Deterministic witness: the exact torn interleaving, pinned as a test so
  // the finding is reproducible without random search. NOTE (Oracle C5):
  // this checks the MODEL, not addon.py — no code change can flip it.
  // The code↔model tether is test_addon_publish_pattern_tripwire in
  // tests/test_spec_conformance.py, which fails when addon.py's two-write
  // publish shape changes and names this module for manual cleanup.
  run tornPublishWitnessTest = init
    .then(handlerCapture)   // handler enters with cfg gen 0
    .then(publishWrite1)    // refresh thread: _header_index = gen 1
    .then(handlerResolve)   // identity check passes (cfg field still gen 0)
    .then(publishWrite2)    // refresh thread: _header_index_config = gen 1
    .then(handlerServe)     // decide() ran with cfg 0 + index 1
    .expect(servedMixed)
}

// The two checkable configurations. CI contract:
//   quint test --main=snapshotCurrent specs/decide.qnt
//     → tornPublishWitnessTest PASSES (the addon.py two-write publish race
//       is still reproducible; delete the witness when the code is fixed).
//   quint run --main=snapshotFixed --invariant=servedCoherent specs/decide.qnt
//     → no violation (an atomic snapshot swap closes the race).
module snapshotCurrent {
  import snapshotRace(ATOMIC_PUBLISH = false).*
}
module snapshotFixed {
  import snapshotRace(ATOMIC_PUBLISH = true).*
}
